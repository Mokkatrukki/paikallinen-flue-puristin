# No cloud API keys needed for the model — this project only talks to the
# local llama.cpp/Gemma server on isomankeli (192.168.1.26:8080), configured
# directly in src/agents/gemma.ts via setProvider().

# Apple Music MusicKit — https://developer.apple.com/account/
# Create a MusicKit identifier + key, download the .p8 file (ÄLÄ commitoi
# sitä — *.p8 on .gitignoressa). Then run `bun scripts/apple-music-auth.ts`
# once to authorize a listener account (opens a local login page).
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_KEY_ID=your_apple_key_id_here
APPLE_PRIVATE_KEY_FILE=./AuthKey_XXXXXXXXXX.p8
# Alternative to the file (paste the key contents directly):
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...

# Optional — defaults to the authorized listener's own storefront, or "us".
# APPLE_MUSIC_STOREFRONT=fi

# Optional — where the listener's Music User Token is persisted after
# scripts/apple-music-auth.ts. Defaults to data/apple-music-token.json
# (already gitignored).
# APPLE_MUSIC_TOKEN_FILE=data/apple-music-token.json
